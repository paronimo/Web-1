<!DOCTYPE html>
<html>
<head>
    <title>Ecommerce</title>
    <link rel="stylesheet" href="/css/styles.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
<header>
    <div class="container-padre">
        <h1>Mi Ecommerce</h1>

        <div class="barra-busqueda">
            <form class="formulario-busqueda" action="/search" method="get">
                <input type="text" class="campo-busqueda" name="query" placeholder="Buscar...">
                <button type="submit" class="boton-buscar">Buscar</button>
            </form>
        </div>

        <div class="header-right">
            <a href="/cart" class="cart-button">
                <span class="cart-count">
                    <span class="cart-icon">🛒</span>
                    <span class="cart-value"><%= cartCount || 0 %></span>
                </span>
            </a>
            <div class="Perfil-container">
                <img src="/images/perfil.webp" class="perfil" alt="Foto de perfil">
                <span class="username"><%= typeof user !== 'undefined' && user ? user : 'Invitado' %></span>
            </div>
        </div>          
  </div>

    <nav>
        <a href="/">Home</a>
        <a href="/login">Login</a>
        <a href="/register">Registro</a>
    </nav>
</header>
