<div class="target <%= producto.stock === 0 ? 'target--soldout' : '' %>">
    <a href="<%= producto.stock === 0 ? 'javascript:void(0)' : '/products/' + producto.id %>"
       class="target-link <%= producto.stock === 0 ? 'disabled-link' : '' %>">
        <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>">
        <div class="target-info">
            <h3><%= producto.nombre %></h3>
            <p><%= producto.precio %> pts</p>
        </div>
        <% if (producto.stock === 0) { %>
            <span class="badge-sin-stock">Sin stock</span>
        <% } %>
    </a>
</div>