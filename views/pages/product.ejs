<main>
    <section class="products">
        <div class="product-detail-container">
            <div class="product-image-container">
                <img src="<%= producto.imagen || '/images/perfil.webp' %>" alt="<%= producto.nombre %>" class="product-image" onerror="this.src='/images/perfil.webp'">
            </div>

            <div class="product-info-container">
                <h1 class="product-title"><%= producto.nombre %></h1>

                <p class="product-meta"><strong>Categoría:</strong> <%= producto.categoria %></p>
                <p class="product-meta"><strong>Stock:</strong> <%= producto.stock %> unidades</p>

                <div class="product-price-box">
                    <p class="product-price">
                        <%= producto.precio %> <span class="product-price-unit">pts</span>
                    </p>
                </div>

                <p class="product-description"><%= producto.descripcion %></p>

                <form action="/cart/add" method="POST">
                    <input type="hidden" name="productId" value="<%= producto.id %>">
                    <button type="submit" class="btn-add-cart" <%= producto.stock === 0 ? 'disabled' : '' %>>
                        <%= producto.stock === 0 ? 'Sin stock' : '🛒 Agregar al carrito' %>
                    </button>
                </form>

                <a href="/cart" class="btn-view-cart">
                    Ver carrito
                </a>
            </div>
        </div>
    </section>

    <section class="products">
        <h2>Productos relacionados</h2>
        <% if (productosRelacionados && productosRelacionados.length) { %>
            <div class="products-grid">
                <% productosRelacionados.forEach(productoRelacionado => { %>
                    <%- include('../partials/target', { producto: productoRelacionado }) %>
                <% }) %>
            </div>
        <% } else { %>
            <p>No hay productos relacionados disponibles.</p>
        <% } %>
    </section>
</main>





























