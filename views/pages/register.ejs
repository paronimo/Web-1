<%- include('../partials/header', { title: 'Registro - Mi Ecommerce', currentPage: 'register' }) %>

<div class="auth-container">
    <div class="auth-card slide-up">
        <div class="register">
            <% if (typeof error !== 'undefined') { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>
            
            <form action="/register" method="POST" id="registerForm" onsubmit="return validateForm()">
                <div class="form-group">
                    <label for="name" class="form-label">Nombre completo</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="input"
                        placeholder="Ingresa tu nombre completo"
                        required
                        autofocus
                    >
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">Correo electrónico</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="input"
                        placeholder="tu@email.com"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">Contraseña</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="input"
                        placeholder="Crea una contraseña segura"
                        required
                        minlength="8"
                    >
                    <div id="passwordFeedback" class="password-feedback"></div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword" class="form-label">Confirmar contraseña</label>
                    <input
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        class="input"
                        placeholder="Repite tu contraseña"
                        required
                        minlength="8"
                    >
                </div>

                <button type="submit" class="btn btn-primary btn-full">
                    Crear cuenta
                </button>
            </form>

            <div class="auth-actions">
                <p>¿Ya tienes cuenta? <a href="/login" class="auth-link">Inicia sesión</a></p>
            </div>
        </div>
    </div>
</div>

<style>
    .password-feedback {
        font-size: 12px;
        margin-top: 5px;
        min-height: 20px;
    }
    .password-feedback.error { color: #d32f2f; }
    .password-feedback.success { color: #388e3c; }
    .error-message { color: #d32f2f !important; }
</style>

<script>
    const siteName = 'Mi Ecommerce';
    const prohibitedStrings = ['password', '1234', 'qwerty'];

    function validatePassword(password, name, email) {
        const errors = [];

        // Validar longitud mínima
        if (password.length < 8) {
            errors.push('Mínimo 8 caracteres');
        }

        // Validar que contiene al menos una letra
        if (!/[a-zA-Z]/.test(password)) {
            errors.push('Incluir al menos una letra');
        }
  
        if (!/\d/.test(password)) {       // Validar que contiene al menos un número//
            errors.push('Incluir al menos un número');
        }

        if (!/[!@#$%^&*(),.?":{}<>|]/.test(password)) { // Validar que contiene al menos un carácter especial 
            errors.push('Incluir un carácter especial (! @ # $ % ^ & * ( ) , . ? " : { } | < >)');
        }
 
        const lowerPassword = password.toLowerCase(); // Validar que no contiene cadenas prohibidas
        for (let forbidden of prohibitedStrings) {
            if (lowerPassword.includes(forbidden)) {
                errors.push(`No puede contener: "${forbidden}"`);
            }
        }

        if (lowerPassword.includes(siteName.toLowerCase())) {   // Validar que no contiene el nombre del sitio
            errors.push(`No puede contener el nombre del sitio: "${siteName}"`);
        }

        if (name && lowerPassword.includes(name.toLowerCase())) { // Validar que no contiene el nombre del usuario
            errors.push('No puede contener tu nombre de usuario');
        }

        // Validar que no es igual al email
        if (email && lowerPassword.includes(email.toLowerCase())) {
            errors.push('No puede ser igual a tu email');
        }

        return errors;
    }
        // Validar el formulario antes de enviarlo
    function validateForm() {
        //esto hace que se lean los valores de los campos de nombre, email, contraseña y confirmación de contraseña, 
        // y luego llama a la función validatePassword para verificar si la contraseña cumple 
        // con los criterios establecidos. Si hay errores, muestra una alerta con los mensajes correspondientes y evita que el formulario se envíe. También verifica que las contraseñas coincidan antes de permitir el envío del formulario.
        const name = document.getElementById('name').value.trim();
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        // Validar contraseña
        const errors = validatePassword(password, name, email);

        if (errors.length > 0) {
            alert('Contraseña inválida:\n\n' + errors.join('\n'));
            return false;
        }

        // Validar que las contraseñas coinciden
        if (password !== confirmPassword) {
            alert('Las contraseñas no coinciden');
            return false;
        }

        return true;
    }

    // Validación en tiempo real
    document.getElementById('password').addEventListener('input', function() {
        const password = this.value;
        const name = document.getElementById('name').value.trim();
        const email = document.getElementById('email').value.trim();
        const feedback = document.getElementById('passwordFeedback');

        const errors = validatePassword(password, name, email);

        if (password.length === 0) {
            feedback.textContent = '';
            feedback.className = '';
        } else if (errors.length > 0) {
            feedback.textContent = 'Contraseña débil: ' + errors.slice(0, 2).join(', ');
            feedback.className = 'password-feedback error';
        } else {
            feedback.textContent = '✓ Contraseña válida';
            feedback.className = 'password-feedback success';
        }
    });
</script>

<%- include('../partials/footer') %>
