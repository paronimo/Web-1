<!-- Bloque negro de categorías -->  
<section class="category-strip">
    <button type="button">Electrónica</button>
    <button type="button">Alimentos</button>
    <button type="button">Bebidas</button>
    <button type="button">Indumentaria</button>
    <button type="button">Juegos</button>
    <button type="button">Automotor</button>
    <button type="button">Hogar</button>
    <button type="button">Otros</button>
</section>
<!--  Bloque de productos -->
<div class="products">
    <h2>Productos</h2>
    <div class="products-grid">
        <% if (productos && productos.length) { %>
            <% productos.forEach(producto => { %>
                <%- include('../partials/target', { producto }) %>
            <% }) %>
        <% } else { %>
            <p>No hay productos disponibles en este momento.</p>
        <% } %>
    </div>
</div>

