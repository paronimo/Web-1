<main>
    <section class="products">
        <h1 style="margin-top: 0;">🛒 Carrito de Compras</h1>

        <% if (cartItems && cartItems.length) { %>
            <div style="overflow-x: auto; margin-bottom: 24px;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: var(--primary-soft); border-bottom: 2px solid var(--border);">
                            <th style="padding: 12px; text-align: left; font-weight: 600;">Producto</th>
                            <th style="padding: 12px; text-align: center; font-weight: 600;">Cantidad</th>
                            <th style="padding: 12px; text-align: right; font-weight: 600;">Precio Unitario</th>
                            <th style="padding: 12px; text-align: right; font-weight: 600;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cartItems.forEach(item => { %>
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px; display: flex; align-items: center; gap: 12px;">
                                    <img src="<%= item.imagen %>" alt="<%= item.nombre %>" style="width: 60px; height: 60px; border-radius: 8px; object-fit: cover;">
                                    <span style="font-weight: 500;"><%= item.nombre %></span>
                                </td>
                                <td style="padding: 12px; text-align: center;"><%= item.quantity %></td>
                                <td style="padding: 12px; text-align: right; font-weight: 600;"><%= item.precio %> pts</td>
                                <td style="padding: 12px; text-align: right; font-weight: 700; color: var(--primary);"><%= item.subtotal %> pts</td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 20px; margin-bottom: 24px;">
                <div style="background: var(--surface); padding: 16px; border-radius: 12px; min-width: 280px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                        <span>Subtotal:</span>
                        <span style="font-weight: 600;"><%= total %> pts</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                        <span>Envío:</span>
                        <span style="font-weight: 600;">0 pts</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 18px; font-weight: 700; color: var(--primary);">
                        <span>TOTAL:</span>
                        <span><%= total %> pts</span>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <a href="/" style="flex: 1; padding: 14px; background: var(--surface); color: var(--primary); border: 2px solid var(--primary); border-radius: 12px; font-weight: 700; font-size: 16px; text-align: center; text-decoration: none;">← Volver al listado</a>
                <a href="/checkout" style="flex: 1; padding: 14px; background: var(--primary); color: white; border: none; border-radius: 12px; font-weight: 700; font-size: 16px; text-align: center; text-decoration: none;">Ir a Pagar →</a>
            </div>
        <% } else { %>
            <div style="padding: 32px; text-align: center; background: var(--surface-strong); border-radius: 24px; border: 1px solid var(--border);">
                <h2>Tu carrito está vacío</h2>
                <p>Agrega productos desde la tienda para comenzar tu compra.</p>
                <a href="/" style="display: inline-block; margin-top: 18px; padding: 14px 24px; background: var(--primary); color: white; border-radius: 12px; text-decoration: none; font-weight: 700;">Volver al inicio</a>
            </div>
        <% } %>
    </section>
</main>