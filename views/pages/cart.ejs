<main>
    <section class="products">
        <h1 class="cart-title">🛒 Carrito de Compras</h1>

        <% if (cartItems && cartItems.length) { %>
            <div class="cart-table-wrapper">
                <table class="cart-table">
                    <thead>
                        <tr class="cart-table-header-row">
                            <th class="cart-th-left">Producto</th>
                            <th class="cart-th-center">Cantidad</th>
                            <th class="cart-th-right">Precio Unitario</th>
                            <th class="cart-th-right">Subtotal</th>
                            <th class="cart-th-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cartItems.forEach(item => { %>
                            <tr class="cart-table-row">
                                <td class="cart-td-product">
                                    <img src="<%= item.imagen %>" alt="<%= item.nombre %>" class="cart-product-img">
                                    <span class="cart-product-name"><%= item.nombre %></span>
                                </td>
                                <td class="cart-td-center">
                                    <form action="/cart/update" method="POST" class="cart-update-form">
                                        <input type="hidden" name="productId" value="<%= item.id %>">
                                        <input type="number" name="quantity" value="<%= item.quantity %>" min="1" class="cart-quantity-input">
                                        <button type="submit" class="cart-btn-update">↻</button>
                                    </form>
                                </td>
                                <td class="cart-td-price"><%= item.precio %> pts</td>
                                <td class="cart-td-subtotal"><%= item.subtotal %> pts</td>
                                <td class="cart-td-center">
                                    <form action="/cart/remove" method="POST">
                                        <input type="hidden" name="productId" value="<%= item.id %>">
                                        <button type="submit" class="cart-btn-remove">✕</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="cart-summary-wrapper">
                <div class="cart-summary-box">
                    <div class="cart-summary-row">
                        <span>Subtotal:</span>
                        <span class="cart-summary-value"><%= total %> pts</span>
                    </div>
                    <div class="cart-summary-row">
                        <span>Envío:</span>
                        <span class="cart-summary-value">0 pts</span>
                    </div>
                    <div class="cart-summary-total-row">
                        <span>TOTAL:</span>
                        <span><%= total %> pts</span>
                    </div>
                </div>
            </div>

            <div class="cart-empty-wrapper">
                <form action="/cart/empty" method="POST">
                    <button type="submit" class="cart-btn-empty">Vaciar carrito</button>
                </form>
            </div>

            <div class="cart-actions-wrapper">
                <a href="/" class="btn-back-list">← Volver al listado</a>
                <a href="/checkout" class="btn-checkout">Ir a Pagar →</a>
            </div>
        <% } else { %>
            <div class="cart-empty-message">
                <h2>Tu carrito está vacío</h2>
                <p>Agrega productos desde la tienda para comenzar tu compra.</p>
                <a href="/" class="btn-home">Volver al inicio</a>
            </div>
        <% } %>
    </section>
</main>